{
  "datasets": [
    {
      "name": "a4798d1c",
      "displayName": "joint_budget",
      "config": {
        "version": "1.1",
        "source": "workspace.joint_account_budget_gold.joint_budget",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "3a97cf87",
      "displayName": "Statements with Budget",
      "queryLines": [
        "WITH budgets AS (\n",
        "SELECT *,\n",
        "    b.year * 12 + b.month AS budget_month,\n",
        "    LEAD(b.year * 12 + b.month, 1) OVER (\n",
        "        PARTITION BY b.category \n",
        "        ORDER BY b.year, b.month\n",
        "    ) AS next_budget_month\n",
        "FROM workspace.joint_account_budget_gold.joint_budget b\n",
        ")\n",
        "SELECT \n",
        "    s.year, s.month, s.category,\n",
        "    s.outgoings, s.incomings, \n",
        "    s.previous_outgoings, s.previous_incomings,\n",
        "    s.change_in_outgoings, s.change_in_incomings,\n",
        "    CASE\n",
        "        WHEN b.budget IS NULL THEN 0\n",
        "        ELSE b.budget\n",
        "    END AS budget,\n",
        "    b.previous_budget, b.change_in_budget,\n",
        "    b.budget_month, b.next_budget_month,\n",
        "    CASE\n",
        "        WHEN s.incomings IS NULL THEN -s.outgoings\n",
        "        WHEN s.outgoings IS NULL THEN s.incomings\n",
        "        ELSE s.incomings-s.outgoings\n",
        "    END AS net_balance,\n",
        "    CASE\n",
        "        WHEN b.budget IS NULL THEN -s.outgoings\n",
        "        ELSE b.budget - s.outgoings\n",
        "    END AS buffer_in_budget\n",
        "FROM workspace.joint_statements_gold.joint_statements s\n",
        "LEFT JOIN budgets b\n",
        "    ON s.category = b.category\n",
        "    AND s.year * 12 + s.month >= b.budget_month\n",
        "    AND (b.next_budget_month IS NULL OR s.year * 12 + s.month < b.next_budget_month)\n",
        "ORDER BY s.year, s.month;"
      ],
      "columns": [
        {
          "displayName": "net_savings",
          "description": "Net savings = incomings minus outgoings per category",
          "expression": "`incomings` - `outgoings`"
        }
      ]
    },
    {
      "name": "9a2f50fd",
      "displayName": "joint_statements",
      "config": {
        "version": "1.1",
        "source": "workspace.joint_statements_gold.joint_statements",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "a685c68f",
      "displayName": "Statement Totals",
      "queryLines": [
        "SELECT \n",
        "    s.year, \n",
        "    s.month,\n",
        "    make_date(s.year, s.month, 28) AS date,\n",
        "    SUM(s.incomings) AS total_incomings,\n",
        "    SUM(s.outgoings) AS total_outgoings,\n",
        "    SUM(s.incomings) - SUM(s.outgoings) AS net_balance,\n",
        "    SUM(SUM(s.incomings) - SUM(s.outgoings)) OVER (ORDER BY year, month) AS cumulative_balance\n",
        "FROM workspace.joint_statements_gold.joint_statements s\n",
        "GROUP BY s.year, s.month;"
      ]
    },
    {
      "name": "07e24cc9",
      "displayName": "joint_statements",
      "config": {
        "version": "1.1",
        "source": "workspace.joint_statements_silver.joint_statements",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "year",
            "expr": "YEAR(source.date)"
          },
          {
            "name": "month",
            "expr": "MONTH(source.date)"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "c13a26a7",
      "displayName": "Monthly Incoming Totals Grouped By Description",
      "queryLines": [
        "SELECT\n",
        "  YEAR(date) AS year,\n",
        "  MONTH(date) AS month,\n",
        "  make_date(YEAR(date), MONTH(date), 28) AS date,\n",
        "  TRIM(REGEXP_REPLACE(description, '\\\\s+\\\\d{2}[A-Z]{3}\\\\d{2}\\\\s*$', '')) AS description,\n",
        "  SUM(credit) AS total_incomings\n",
        "FROM\n",
        "  workspace.joint_statements_silver.joint_statements s\n",
        "WHERE\n",
        "  category = 'incomings'\n",
        "GROUP BY\n",
        "  year,\n",
        "  month,\n",
        "  TRIM(REGEXP_REPLACE(description, '\\\\s+\\\\d{2}[A-Z]{3}\\\\d{2}\\\\s*$', ''));"
      ]
    }
  ],
